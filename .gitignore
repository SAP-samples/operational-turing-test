# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version

# Notebooks
.ipynb_checkpoints/

# Cached generated data (regenerate via src/run_ott.py)
data/cache/
*.parquet.tmp

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Build / figure output
figures/out/
*.aux
*.log
*.pdf
!figures/*.pdf       # keep checked-in figures

# Local config overrides
src/config_local.py

# Editable install bookkeeping
src/*.egg-info/
*.egg-info/
build/
dist/

# Third-party dependency clone (commit only the README placeholder)
external/RDBPFN/*
!external/RDBPFN/README.md

# Secrets — NEVER commit. .env.example is the template; .env holds real keys.
.env
.env.local

# Experiment side outputs (regenerate via experiments/run_*.py)
artifacts/kimi_traces*/
artifacts/gpt55_traces*/
artifacts/*pilot*.csv
artifacts/*pilot*.log
artifacts/*smoke*
artifacts/*_azure_results.csv
artifacts/*_azure_traces*/
artifacts/gpt55_selfconsistency_*
artifacts/kimi_live_smoke*
artifacts/gpt55_live_smoke*
