# Pilot experiments. Copy this to .env and fill in your own values.
# DO NOT commit .env.

# ---------- Kimi-K2.6 (the Kimi-K2.6 hosting endpoint) ----------
# experiments/run_kimi_baseline.py
# Either the resource root or the full Azure AI Foundry v1 endpoint works:
#   https://<resource>.services.ai.azure.com
#   https://<resource>.services.ai.azure.com/openai/v1
KIMI_ENDPOINT="https://<your-kimi-host>/openai/v1"
KIMI_API_KEY="<your-kimi-api-key>"
# Optional: override the Kimi deployment name (default: Kimi-K2.6)
# KIMI_MODEL="Kimi-K2.6"
# Optional: use Entra ID instead of KIMI_API_KEY. Requires azure-identity.
# KIMI_AUTH="azure_identity"

# ---------- GPT-5.5 (the GPT-5.5 hosting endpoint) ----------
# experiments/run_gpt55_baseline.py
# Either the resource root or the full Azure AI Foundry v1 endpoint works:
#   https://<resource>.services.ai.azure.com
#   https://<resource>.services.ai.azure.com/openai/v1
GPT55_ENDPOINT="https://<your-gpt55-host>/openai/v1"
GPT55_API_KEY="<your-gpt55-api-key>"
GPT55_API_VERSION="2024-12-01-preview"
GPT55_DEPLOYMENT="gpt-5.5"
# Optional: use Entra ID instead of GPT55_API_KEY. Requires azure-identity.
# GPT55_AUTH="azure_identity"
